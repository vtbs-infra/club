NODE_ENV=development
APP_URL=http://localhost:3000
CLUB_PORT=3000
POSTGRES_HOST_PORT=55432
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# URL-encode POSTGRES_PASSWORD if it contains URI-reserved characters.
COMPOSE_DATABASE_URL=postgres://club:replace-with-a-long-random-database-password@postgres:5432/club
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://club:replace-with-a-long-random-database-password@localhost:55432/club
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Generate a key with: openssl rand -base64 32
ADDRESS_ENCRYPTION_ACTIVE_KEY_VERSION=1
ADDRESS_ENCRYPTION_KEY_RING=1:replace-with-a-base64-encoded-32-byte-key
BILIBILI_LIVE_SOURCE=public-web
BILIBILI_ROSTER_SOURCE=public-web
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/club
# Optional deterministic fake for development/testing; keep none without a provider.
TRACKING_PROVIDER=none
# 方案 1 moe / 方案 2 neon / 方案 3 archive / 方案 4 pixel
UI_THEME=archive
LOG_LEVEL=info
TRUST_PROXY=false

# One-time, non-interactive platform administrator bootstrap only.
# CLUB_ADMIN_PASSWORD=replace-with-a-strong-one-time-password

# Test commands only.
# TEST_DATABASE_URL=postgres://club:club-dev@localhost:55432/club
