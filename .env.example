NODE_ENV=development
APP_URL=http://localhost:3000
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://club:club-dev@localhost:55432/club
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Generate a key with: openssl rand -base64 32
ADDRESS_ENCRYPTION_ACTIVE_KEY_VERSION=1
ADDRESS_ENCRYPTION_KEY_RING=1:replace-with-a-base64-encoded-32-byte-key
BILIBILI_LIVE_SOURCE=public-web
BILIBILI_ROSTER_SOURCE=public-web
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/club
# Optional deterministic fake for development/testing; keep none without a provider.
TRACKING_PROVIDER=none
LOG_LEVEL=info
TRUST_PROXY=false

# Optional. When configured, email verification and password reset are enabled.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Club <no-reply@example.com>
