{
  "name": "@vtbs-infra/club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Bilibili guard gift management platform",
  "license": "Parity-7.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "concurrently --kill-others --names server,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "node dist/server/server/index.js",
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:browser": "pnpm build && playwright test",
    "browser:install": "playwright install chromium",
    "club": "tsx src/server/cli.ts",
    "club:prod": "node dist/server/server/cli.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/infrastructure/db/migrate.ts",
    "db:migrate:prod": "node dist/server/server/infrastructure/db/migrate.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.0",
    "@fastify/swagger": "^9.8.1",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "^5.101.3",
    "better-auth": "^1.6.23",
    "bilibili-live-danmaku": "0.7.16",
    "drizzle-orm": "^0.45.2",
    "exceljs": "4.4.0",
    "fastify": "^5.10.0",
    "lucide-react": "^1.33.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.1",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  }
}
