{
  "name": "@vtbs-infra/club",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Bilibili guard gift management platform",
  "license": "Parity-7.0.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.19 <12"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "node dist/server/server/index.js",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "npm run docs:check && npm run format:check && npm run lint && npm run typecheck",
    "docs:check": "tsx scripts/check-doc-links.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "npm run build && playwright test --project chromium",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "release:check": "tsx scripts/release-check.ts",
    "browser:install": "playwright install chromium",
    "club": "tsx src/server/cli.ts",
    "club:prod": "node dist/server/server/cli.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/infrastructure/db/migrate.ts",
    "db:migrate:prod": "node dist/server/server/infrastructure/db/migrate.js",
    "test:e2e": "npm run build && playwright test --project e2e"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/session": "11.1.2",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "^5.101.3",
    "bilibili-live-danmaku": "0.7.16",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "lucide-react": "^1.33.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode.react": "4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "sharp": "0.35.4",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "^3.9.6",
    "read-excel-file": "^9.3.10",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "protobufjs": false,
    "sharp": true
  },
  "overrides": {
    "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
    "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
    "fast-uri@>=4.0.0 <4.1.3": "4.1.3",
    "find-my-way@<=9.6.0": "9.7.0",
    "nanoid@<3.3.18": "3.3.18",
    "postcss@<8.5.23": "8.5.23"
  }
}
