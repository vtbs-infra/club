{
  "name": "@vtbs-infra/club",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Bilibili guard gift management platform",
  "license": "Parity-7.0.0",
  "engines": {
    "node": ">=24.2 <25",
    "npm": ">=11.19 <12"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "node dist/server/server/index.js",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run db:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:container": "node tests/container/smoke.mjs",
    "test:browser": "npm run build && playwright test --project chromium",
    "audit": "npm audit --audit-level=high",
    "release:check": "tsx scripts/release-check.ts",
    "browser:install": "playwright install chromium",
    "club": "tsx src/server/cli.ts",
    "club:prod": "node dist/server/server/cli.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx scripts/check-migrations.ts",
    "db:migrate": "tsx src/server/infrastructure/db/migrate.ts",
    "db:migrate:prod": "node dist/server/server/infrastructure/db/migrate.js",
    "test:e2e": "npm run build && playwright test --project e2e"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "^10.1.6",
    "@fastify/session": "11.1.5",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.9.2",
    "bilibili-live-danmaku": "0.7.16",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "sharp": "0.35.5",
    "temporal-polyfill": "1.0.6",
    "typebox": "1.4.3",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tanstack/react-query": "^5.104.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "lucide-react": "^1.61.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "^3.9.10",
    "qrcode.react": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.12",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "protobufjs": false
  }
}
